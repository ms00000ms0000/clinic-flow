              "name": "telegram_message",
              "value": "={{\"Today's Patients\\n\\n\" + $json.data   .map(p => {     let slot = p['Slot Selection'];     let shortSlot = slot.includes('9 AM') ? 'Slot I' : slot.includes('2 PM') ? 'Slot II' : slot.includes('6 PM') ? 'Slot III' : slot;     let slotOrder = slot.includes('9 AM') ? 1 : slot.includes('2 PM') ? 2 : slot.includes('6 PM') ? 3 : 4;     return { name: p['Patient Name'], phone: p['Phone Number'], shortSlot: shortSlot, order: slotOrder };   })   .sort((a, b) => a.order - b.order)   .map((p, i) => (i+1) + \". \" + p.name + \" - \" + p.shortSlot + \" - \" + p.phone)   .join('\\n')}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
